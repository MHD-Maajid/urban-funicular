#define FILTERSCRIPT

#include <a_samp>
#include <chandlingsvr>

/*
 * Auto-generated by vehicle-generation/tools/generate_vehicle.py
 * Vehicle : Nightfire
 * Replaces: model 411 (infernus)
 *
 * Players need matching DFF/TXD in GTA:SA (same filenames as the stock car
 * if keep_stock_filenames is true). Physics is pushed by CHandling.
 *
 * ApplyCustomHandling_nightfire(411);
 */

stock ApplyCustomHandling_nightfire(modelid)
{
	SetModelHandlingFloat(modelid, HANDL_FMASS, 1400.0);
	SetModelHandlingFloat(modelid, HANDL_FTURNMASS, 2725.3);
	SetModelHandlingFloat(modelid, HANDL_FDRAGMULTIPLIER, 1.45);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_X, 0.0);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Y, 0.0);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Z, -0.25);
	SetModelHandlingInt(modelid, HANDL_NPERCENTSUBMERGED, 70);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONMULTIPLIER, 0.78);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONLOSS, 0.82);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONBIAS, 0.5);
	SetModelHandlingInt(modelid, HANDL_TR_NNUMBEROFGEARS, 5);
	SetModelHandlingFloat(modelid, HANDL_TR_FMAXVELOCITY, 250.0);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEACCELERATION, 13.5);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEINERTIA, 8.0);
	SetModelHandlingInt(modelid, HANDL_TR_NDRIVETYPE, 52);
	SetModelHandlingInt(modelid, HANDL_TR_NENGINETYPE, 80);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEDECELERATION, 12.5);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEBIAS, 0.52);
	SetModelHandlingInt(modelid, HANDL_BABS, 0);
	SetModelHandlingFloat(modelid, HANDL_FSTEERINGLOCK, 32.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONFORCELEVEL, 1.25);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONDAMPINGLEVEL, 0.19);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONHIGHSPDCOMDAMP, 0.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONUPPERLIMIT, 0.25);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONLOWERLIMIT, -0.1);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONBIAS, 0.5);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONANTIDIVEMULT, 0.4);
	SetModelHandlingFloat(modelid, HANDL_FSEATOFFSETDISTANCE, 0.37);
	SetModelHandlingFloat(modelid, HANDL_FCOLLISIONDAMAGEMULT, 0.55);
	SetModelHandlingInt(modelid, HANDL_MODELFLAGS, 1073750020);
	SetModelHandlingInt(modelid, HANDL_HANDLINGFLAGS, 12599296);
	SetModelHandlingInt(modelid, HANDL_FRONTLIGHTS, 1);
	SetModelHandlingInt(modelid, HANDL_REARLIGHTS, 1);
}

public OnFilterScriptInit()
{
#if !defined FILTERSCRIPT_NO_AUTO_APPLY
	ApplyCustomHandling_nightfire(411);
#endif
	printf("[vehicle-generation] applied 'Nightfire' handling to model 411");
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
	if(GetVehicleModel(vehicleid) == 411)
		SetVehicleHealth(vehicleid, 1000.0);
	return 1;
}
