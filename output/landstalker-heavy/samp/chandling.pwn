#define FILTERSCRIPT

#include <a_samp>
#include <chandlingsvr>

/*
 * Auto-generated by vehicle-generation/tools/generate_vehicle.py
 * Vehicle : Landstalker Heavy
 * Replaces: model 400 (landstal)
 *
 * Players need matching DFF/TXD in GTA:SA (same filenames as the stock car
 * if keep_stock_filenames is true). Physics is pushed by CHandling.
 *
 * ApplyCustomHandling_landstalker_heavy(400);
 */

stock ApplyCustomHandling_landstalker_heavy(modelid)
{
	SetModelHandlingFloat(modelid, HANDL_FMASS, 2200.0);
	SetModelHandlingFloat(modelid, HANDL_FTURNMASS, 6000.0);
	SetModelHandlingFloat(modelid, HANDL_FDRAGMULTIPLIER, 2.8);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_X, 0.0);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Y, 0.0);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Z, -0.3);
	SetModelHandlingInt(modelid, HANDL_NPERCENTSUBMERGED, 85);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONMULTIPLIER, 0.8);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONLOSS, 0.85);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONBIAS, 0.5);
	SetModelHandlingInt(modelid, HANDL_TR_NNUMBEROFGEARS, 5);
	SetModelHandlingFloat(modelid, HANDL_TR_FMAXVELOCITY, 155.0);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEACCELERATION, 9.0);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEINERTIA, 20.0);
	SetModelHandlingInt(modelid, HANDL_TR_NDRIVETYPE, 52);
	SetModelHandlingInt(modelid, HANDL_TR_NENGINETYPE, 68);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEDECELERATION, 7.5);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEBIAS, 0.6);
	SetModelHandlingInt(modelid, HANDL_BABS, 0);
	SetModelHandlingFloat(modelid, HANDL_FSTEERINGLOCK, 35.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONFORCELEVEL, 2.2);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONDAMPINGLEVEL, 0.09);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONHIGHSPDCOMDAMP, 0.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONUPPERLIMIT, 0.32);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONLOWERLIMIT, -0.16);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONBIAS, 0.5);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONANTIDIVEMULT, 0.25);
	SetModelHandlingFloat(modelid, HANDL_FSEATOFFSETDISTANCE, 0.27);
	SetModelHandlingFloat(modelid, HANDL_FCOLLISIONDAMAGEMULT, 0.18);
	SetModelHandlingInt(modelid, HANDL_MODELFLAGS, 32);
	SetModelHandlingInt(modelid, HANDL_HANDLINGFLAGS, 5242882);
	SetModelHandlingInt(modelid, HANDL_FRONTLIGHTS, 0);
	SetModelHandlingInt(modelid, HANDL_REARLIGHTS, 1);
}

public OnFilterScriptInit()
{
#if !defined FILTERSCRIPT_NO_AUTO_APPLY
	ApplyCustomHandling_landstalker_heavy(400);
#endif
	printf("[vehicle-generation] applied 'Landstalker Heavy' handling to model 400");
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
	if(GetVehicleModel(vehicleid) == 400)
		SetVehicleHealth(vehicleid, 1250.0);
	return 1;
}
