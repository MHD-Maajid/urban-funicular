#define FILTERSCRIPT

#include <a_samp>
#include <chandlingsvr>

/*
 * Auto-generated by vehicle-generation/tools/generate_vehicle.py
 * Vehicle : Sultan Sport
 * Replaces: model 560 (sultan)
 *
 * Players need matching DFF/TXD in GTA:SA (same filenames as the stock car
 * if keep_stock_filenames is true). Physics is pushed by CHandling.
 *
 * ApplyCustomHandling_sultan_sport(560);
 */

stock ApplyCustomHandling_sultan_sport(modelid)
{
	SetModelHandlingFloat(modelid, HANDL_FMASS, 1400.0);
	SetModelHandlingFloat(modelid, HANDL_FTURNMASS, 3400.0);
	SetModelHandlingFloat(modelid, HANDL_FDRAGMULTIPLIER, 2.2);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_X, 0.0);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Y, 0.1);
	SetModelHandlingFloat(modelid, HANDL_CENTREOFMASS_Z, -0.1);
	SetModelHandlingInt(modelid, HANDL_NPERCENTSUBMERGED, 75);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONMULTIPLIER, 0.85);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONLOSS, 0.8);
	SetModelHandlingFloat(modelid, HANDL_FTRACTIONBIAS, 0.5);
	SetModelHandlingInt(modelid, HANDL_TR_NNUMBEROFGEARS, 5);
	SetModelHandlingFloat(modelid, HANDL_TR_FMAXVELOCITY, 215.0);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEACCELERATION, 12.8);
	SetModelHandlingFloat(modelid, HANDL_TR_FENGINEINERTIA, 5.0);
	SetModelHandlingInt(modelid, HANDL_TR_NDRIVETYPE, 52);
	SetModelHandlingInt(modelid, HANDL_TR_NENGINETYPE, 80);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEDECELERATION, 11.0);
	SetModelHandlingFloat(modelid, HANDL_FBRAKEBIAS, 0.5);
	SetModelHandlingInt(modelid, HANDL_BABS, 0);
	SetModelHandlingFloat(modelid, HANDL_FSTEERINGLOCK, 32.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONFORCELEVEL, 1.25);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONDAMPINGLEVEL, 0.16);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONHIGHSPDCOMDAMP, 0.0);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONUPPERLIMIT, 0.28);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONLOWERLIMIT, -0.2);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONBIAS, 0.5);
	SetModelHandlingFloat(modelid, HANDL_FSUSPENSIONANTIDIVEMULT, 0.3);
	SetModelHandlingFloat(modelid, HANDL_FSEATOFFSETDISTANCE, 0.25);
	SetModelHandlingFloat(modelid, HANDL_FCOLLISIONDAMAGEMULT, 0.45);
	SetModelHandlingInt(modelid, HANDL_MODELFLAGS, 10240);
	SetModelHandlingInt(modelid, HANDL_HANDLINGFLAGS, 67108866);
	SetModelHandlingInt(modelid, HANDL_FRONTLIGHTS, 1);
	SetModelHandlingInt(modelid, HANDL_REARLIGHTS, 1);
}

public OnFilterScriptInit()
{
#if !defined FILTERSCRIPT_NO_AUTO_APPLY
	ApplyCustomHandling_sultan_sport(560);
#endif
	printf("[vehicle-generation] applied 'Sultan Sport' handling to model 560");
	return 1;
}

public OnVehicleSpawn(vehicleid)
{
	if(GetVehicleModel(vehicleid) == 560)
		SetVehicleHealth(vehicleid, 1000.0);
	return 1;
}
